{
  "name": "omarchy-sandbox-mcp",
  "version": "0.1.0",
  "description": "MCP server that starts throwaway Omarchy desktops (the omarchy-sandbox Docker image) and lets agents drive them",
  "license": "MIT",
  "type": "module",
  "bin": {
    "omarchy-sandbox-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "prepare": "tsc",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
